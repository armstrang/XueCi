<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash (SplashScreen API on every Android version): the round artwork on the app's background, held until
         the first Flutter frame is on screen (MainActivity, at most 2.5 s), then the normal theme. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mm_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Behind the Flutter view: the app's background, so there is no flash in either theme -->
    <style name="NormalTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mm_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
