<?xml version="1.0" encoding="utf-8"?>
<!-- v1.4 word widget, wide (3×2, 4×2): the hanzi on the left, the rest on the right. XueciWordWidget.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ww_bg"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/ww_hanbox"
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/ww_han"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="center_vertical"
            android:scaleType="fitStart"
            android:tint="@color/ww_han" />

        <TextView
            android:id="@+id/ww_seal"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="16dp"
            android:background="@drawable/ww_seal"
            android:fontFamily="serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/ww_seal_fg"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="22dp"
        android:scaleType="fitXY"
        android:src="@drawable/ww_line" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ww_head"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ww_uprev"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ww_chev_left"
                android:tint="@color/ww_soft" />

            <ImageView
                android:id="@+id/ww_unext"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ww_chev_right"
                android:tint="@color/ww_soft" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ww_py"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/ww_s0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/ww_mean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:paddingEnd="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ww_fg"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ww_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ww_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ww_btn"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ww_chev_left"
                android:tint="@color/ww_fg" />

            <ImageView
                android:id="@+id/ww_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/ww_btn_on"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ww_chev_right"
                android:tint="@color/ww_btn_on_fg" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
