<?xml version="1.0" encoding="utf-8"?>
<!-- v1.4 word widget, upright (2×3; from about 2×4 the example sentence shows): XueciWordWidget.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ww_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="2dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ww_head"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ww_uprev"
                android:layout_width="30dp"
                android:layout_height="44dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ww_chev_left"
                android:tint="@color/ww_soft" />

            <ImageView
                android:id="@+id/ww_unext"
                android:layout_width="30dp"
                android:layout_height="44dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ww_chev_right"
                android:tint="@color/ww_soft" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/ww_hanbox"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="4dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/ww_han"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitStart"
                android:tint="@color/ww_han" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ww_py"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/ww_s0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ww_s5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/ww_mean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:paddingEnd="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ww_fg"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ww_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitXY"
            android:src="@drawable/ww_line"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ww_sent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingEnd="12dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:textColor="@color/ww_fg"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ww_tr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ww_soft"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ww_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/ww_soft"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ww_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ww_btn"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ww_chev_left"
                android:tint="@color/ww_fg" />

            <ImageView
                android:id="@+id/ww_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/ww_btn_on"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ww_chev_right"
                android:tint="@color/ww_btn_on_fg" />
        </LinearLayout>
</LinearLayout>
