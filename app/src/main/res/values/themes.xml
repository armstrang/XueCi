<resources>
    <style name="Theme.XueCi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mm_brand</item>
        <item name="android:windowBackground">@color/mm_bg</item>
        <item name="android:statusBarColor">@color/mm_bg</item>
        <item name="android:navigationBarColor">@color/mm_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Splash: the app icon on the app's background, then the normal theme -->
    <style name="Theme.XueCi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mm_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.XueCi</item>
    </style>
</resources>
